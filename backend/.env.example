# Copy this file to ".env" and fill in real values. Never commit ".env" to git.
# The server refuses to start if any REQUIRED variable below is missing.

PORT=3000

# ------------------------- REQUIRED AT STARTUP -------------------------

# Random long string — used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin password, stored as a BCRYPT HASH — never plaintext.
# Generate the hash for your chosen password with:
# node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD_HERE', 10))"
ADMIN_PASSWORD_HASH=

# Permanent storage for provider/model settings AND user accounts
# (JSONBin.io — one bin; its ID and master key live only here, never in JSONBin).
# Create a free bin at jsonbin.io, then put its Bin ID below.
JSONBIN_BIN_ID=
JSONBIN_API_KEY=

# ------------------------- EMAIL VERIFICATION --------------------------

# Resend API key — required for signup verification codes.
# Without it, signups fail with a clear "not configured" error.
RESEND_API_KEY=

# ------------------------- AI PROVIDERS --------------------------------
# One variable per provider you connect in the admin panel. The admin panel
# only stores the VARIABLE NAME — the key itself stays here on the server.

OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
